{
  "name": "token-intelligence",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:check": "drizzle-kit check",
    "sdk:build": "npm --prefix packages/sdk-typescript run build",
    "ti": "tsx scripts/ti.ts",
    "verify": "npm run predeploy",
    "pricing:diff": "tsx scripts/pricing-diff.ts",
    "admin:rollup": "tsx scripts/admin-rollup.ts",
    "admin:grant": "tsx scripts/grant-platform-admin.ts",
    "release:config": "tsx scripts/release-config.ts",
    "release:verify": "tsx scripts/release-verify.ts",
    "predeploy": "npm run lint && npm run typecheck && npm test && npm run pricing:diff && npm run db:check && npm run db:migrate && npm run db:verify && TOKEN_INTELLIGENCE_INTEGRATION_TESTS=1 npm run test:integration && TOKEN_INTELLIGENCE_E2E_SEED=1 npx tsx scripts/seed-e2e.ts && npm run admin:rollup && npm run admin:rollup && npm run sdk:build && PYTHONPATH=packages/sdk-python python3 -c \"from token_intelligence import TokenIntelligenceClient, TokenIntelligenceError; assert TokenIntelligenceClient and TokenIntelligenceError\" && npm run ti -- --help && npm run build && npm run test:e2e",
    "env:validate": "tsx scripts/release/validate-env.ts",
    "workos:verify": "tsx scripts/release/workos-verify.ts",
    "stripe:verify": "tsx scripts/release/stripe-verify.ts",
    "mcp:verify": "tsx scripts/release/mcp-verify.ts",
    "providers:verify": "tsx scripts/release/validate-providers.ts",
    "release:manifest": "tsx scripts/release/release-manifest.ts",
    "release:report": "tsx scripts/release/release-report.ts",
    "release:verify:deployment": "tsx scripts/release/verify-deployment.ts",
    "release:verify:manifest": "tsx scripts/release/verify-manifest.ts",
    "release:gate": "tsx scripts/release-gate.ts",
    "release:gate:production": "tsx scripts/release-gate.ts --require-production-providers"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.12.0",
    "drizzle-orm": "^0.45.2",
    "js-tiktoken": "^1.0.21",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
