# Copy locally to .env and load securely. Never commit real credentials.
PORT=3000
# JSON: at least one tenant and unique secret of >=32 characters. Use secure random values.
GATEWAY_TENANTS_JSON='{"pilot":"replace_with_a_random_32_character_or_longer_secret"}'
# Explicit aliases. Rates are illustrative configuration, not verified current pricing.
GATEWAY_ROUTES_JSON='{"economy":{"provider":"openai","model":"gpt-4o-mini","inputPerMillionUsd":0.15,"outputPerMillionUsd":0.60}}'
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GATEWAY_ADMIN_KEY=
GATEWAY_CACHE_TTL_SECONDS=120
GATEWAY_CACHE_MAX_ENTRIES=256
GATEWAY_RPM_PER_TENANT=60
