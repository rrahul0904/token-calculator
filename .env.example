# Core
APP_BASE_URL=http://localhost:3000
DATABASE_URL=

# PulseAtlas portfolio observability (optional, fail-open, content-blind)
NEXT_PUBLIC_PULSEATLAS_ENDPOINT=
NEXT_PUBLIC_PULSEATLAS_WRITE_KEY=
NEXT_PUBLIC_PULSEATLAS_ENVIRONMENT=production

# WorkOS AuthKit (optional for public calculator; required for /app)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
WORKOS_WEBHOOK_SECRET=

# Stripe Billing (required for live Pro/Team checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Secret vault: 32-byte key encoded as base64
TOKEN_INTELLIGENCE_ENCRYPTION_KEY=

# Vercel Cron authorization for retention enforcement
CRON_SECRET=

# Optional Redis. The launch gateway limiter is PostgreSQL-backed and does not require Redis.
REDIS_URL=

# Optional system/provider test credentials. Customer BYOK keys are encrypted separately.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# GitHub outcome attribution
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional OpenTelemetry export
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Signed outbound audit/alert webhook deliveries
TOKEN_INTELLIGENCE_WEBHOOK_SECRET=
